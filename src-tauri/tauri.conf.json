{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Garner",
  "identifier": "money.garner.dev",
  "build": {
    "beforeDevCommand": "bun run apps && bun run dev --port 5174 --strictPort",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Garner",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "allowLinkPreview": false,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Finance",
    "icon": ["icons/32x32.png", "icons/icon.icns", "icons/icon.icon"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "27.0" }
  }
}
