{
  "compilerOptions": {
    "module": "preserve",
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"],
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "host", "vite.config.ts", "vite.apps.config.ts"]
}
