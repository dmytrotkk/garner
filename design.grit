language js

or {
  JsxString(),
  JsStringLiteralExpression(),
  JsTemplateChunkElement()
} as $class where {
  $class <: r"(?s).*(?:rounded\S*-(?:full|none)|bg-(?:linear|radial|conic)).*",
  register_diagnostic(span=$class, message="Outside the design tokens, see docs/design.md", severity="error")
}
